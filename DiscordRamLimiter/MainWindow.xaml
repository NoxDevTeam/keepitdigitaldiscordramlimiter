<Window x:Class="DiscordRamLimiter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Keep It Digital RAM Limiter"
        Width="620" Height="720" MinWidth="620" MinHeight="720"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="Segoe UI" Foreground="#F4F7FF"
        Loaded="Window_Loaded" StateChanged="Window_StateChanged"
        Closing="Window_Closing" MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.Resources>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#8994AA" />
        <Geometry x:Key="DiscordIconGeometry">M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189Z</Geometry>
        <Geometry x:Key="SpotifyIconGeometry">M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z</Geometry>
        <Geometry x:Key="ChromeIconGeometry">M12 0C8.21 0 4.831 1.757 2.632 4.501l3.953 6.848A5.454 5.454 0 0 1 12 6.545h10.691A12 12 0 0 0 12 0zM1.931 5.47A11.943 11.943 0 0 0 0 12c0 6.012 4.42 10.991 10.189 11.864l3.953-6.847a5.45 5.45 0 0 1-6.865-2.29zm13.342 2.166a5.446 5.446 0 0 1 1.45 7.09l.002.001h-.002l-5.344 9.257c.206.01.413.016.621.016 6.627 0 12-5.373 12-12 0-1.54-.29-3.011-.818-4.364zM12 16.364a4.364 4.364 0 1 1 0-8.728 4.364 4.364 0 0 1 0 8.728Z</Geometry>

        <Style x:Key="WindowButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Background" Value="#171D2A" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Surface" CornerRadius="10" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#252D3D" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.68" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Foreground" Value="#E9EDFA" />
            <Setter Property="Background" Value="#212838" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Surface" CornerRadius="12"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#30394C" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#2A3346" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#47536B" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernCheckBoxStyle" TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="#E8ECF7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Box" Width="20" Height="20" CornerRadius="6"
                                    Background="#202737" BorderBrush="#46516A" BorderThickness="1.5">
                                <Path x:Name="CheckMark" Width="10" Height="8"
                                      Data="M1,4 L4,7 L9,1" Stroke="#FFFFFF" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0" />
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#7C6CFF" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="#9C91FF" />
                                <Setter TargetName="CheckMark" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#A69CFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProcessCardStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="#151B27" />
            <Setter Property="BorderBrush" Value="#293142" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="15" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Border CornerRadius="28" Background="#0C1018" BorderBrush="#252C3A" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="36" ShadowDepth="0" Opacity="0.55" Color="#02040A" />
            </Border.Effect>
        </Border>

        <Grid Margin="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="66" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="44" Height="44" CornerRadius="13" VerticalAlignment="Center"
                        Background="#121827" BorderBrush="#29354A" BorderThickness="1">
                    <Image Width="40" Height="40" Source="Assets/keepitdigital.png" Stretch="Uniform" />
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="KEEP IT DIGITAL" FontSize="13" FontWeight="Bold" Foreground="#F2F4FC" />
                    <TextBlock Text="RAM LIMITER  /  CONTROL CENTER" Margin="0,2,0,0"
                               FontSize="9" FontWeight="SemiBold" Foreground="#77839A" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource WindowButtonStyle}"
                            AutomationProperties.Name="Minimize to system tray"
                            ToolTip="Minimize to system tray"
                            Click="MinimizeButton_Click">
                        <Path Data="M0,0 L11,0" Stroke="#9DA7BA" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Button>
                    <Button Margin="8,0,0,0"
                            Style="{StaticResource WindowButtonStyle}"
                            AutomationProperties.Name="Close window and keep running"
                            ToolTip="Close window and keep running"
                            Click="CloseButton_Click">
                        <Path Data="M0,0 L9,9 M9,0 L0,9" Stroke="#FF8996" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Button>
                </StackPanel>
            </Grid>
            <Border Grid.Row="0" Height="1" Margin="24,0" VerticalAlignment="Bottom" Background="#202735" />

            <StackPanel Grid.Row="1" Margin="30,20,30,24">
                <TextBlock Text="Memory control, simplified." FontSize="25" FontWeight="Bold" Foreground="#F4F6FC" />
                <TextBlock Text="One switch keeps your selected apps and safe background utilities tidy."
                           Margin="0,6,0,0" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />

                <Border Height="184" Margin="0,18,0,0" CornerRadius="22"
                        BorderBrush="#37345B" BorderThickness="1">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#1A1E34" Offset="0" />
                            <GradientStop Color="#141A28" Offset="0.55" />
                            <GradientStop Color="#121823" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid Margin="24,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="230" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <Border HorizontalAlignment="Left" Padding="10,5" CornerRadius="12" Background="#222A3A">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#FF8996" VerticalAlignment="Center" />
                                    <TextBlock x:Name="StatusText" Text="Limiter Disabled" Margin="7,0,0,0"
                                               Foreground="#FF8996" FontSize="11" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="CURRENT MEMORY" Margin="0,17,0,0"
                                       FontSize="10" FontWeight="Bold" Foreground="#7E8AA0" />
                            <TextBlock x:Name="CurrentRamText" Text="0 MB" Margin="0,1,0,0"
                                       FontSize="36" FontWeight="Bold" Foreground="#FFFFFF" />
                            <TextBlock Text="Combined tracked working set" Margin="0,1,0,0"
                                       FontSize="11" Foreground="#79859B" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="LimiterToggleButton" Width="214" Height="74"
                                    AutomationProperties.Name="Toggle RAM limiter"
                                    Click="LimiterToggleButton_Click" Background="Transparent"
                                    BorderThickness="0" Cursor="Hand" FocusVisualStyle="{x:Null}"
                                    OverridesDefaultStyle="True">
                                <Button.Template>
                                    <ControlTemplate TargetType="{x:Type Button}"><ContentPresenter /></ControlTemplate>
                                </Button.Template>
                                <Grid Width="214" Height="74">
                                    <Border x:Name="ToggleGlow" Margin="7" CornerRadius="37" Background="#36CE7D">
                                        <Border.Effect>
                                            <DropShadowEffect x:Name="ToggleGlowEffect" BlurRadius="24"
                                                              ShadowDepth="0" Opacity="0" Color="#36CE7D" />
                                        </Border.Effect>
                                    </Border>
                                    <Border x:Name="ToggleTrack" CornerRadius="37" BorderThickness="1">
                                        <Border.BorderBrush><SolidColorBrush x:Name="ToggleTrackBorderBrush" Color="#463743" /></Border.BorderBrush>
                                        <Border.Background><SolidColorBrush x:Name="ToggleTrackBrush" Color="#9B424C" /></Border.Background>
                                    </Border>
                                    <Border x:Name="ToggleThumb" Width="64" Height="64" Margin="5"
                                            HorizontalAlignment="Left" CornerRadius="32" Background="#F7F9FF">
                                        <Border.RenderTransform><TranslateTransform x:Name="ToggleThumbTransform" X="0" /></Border.RenderTransform>
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.28" Color="#000000" />
                                        </Border.Effect>
                                        <TextBlock x:Name="ToggleThumbLabel" Text="OFF" Foreground="#D84A57"
                                                   FontSize="16" FontWeight="Black"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </Button>
                            <TextBlock Text="Click to enable or disable" Margin="0,8,0,0"
                                       HorizontalAlignment="Center" FontSize="10" Foreground="#78849A" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Margin="0,20,0,0">
                    <TextBlock Text="TRACKED APPLICATIONS" FontSize="10" FontWeight="Bold" Foreground="#7F8BA0" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <TextBlock x:Name="AdditionalCountText" Text="EXTRAS: 0"
                                   Margin="0,0,12,0" FontSize="9" FontWeight="Bold" Foreground="#7F8BA0" />
                        <TextBlock Text="LIVE" FontSize="9" FontWeight="Bold" Foreground="#58D695" />
                    </StackPanel>
                </Grid>

                <Grid Height="104" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource ProcessCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Width="36" Height="36" CornerRadius="11" Background="#5865F2">
                                <Viewbox Width="21" Height="21">
                                    <Path Width="24" Height="24" Data="{StaticResource DiscordIconGeometry}" Fill="#FFFFFF" Stretch="Uniform" />
                                </Viewbox>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Discord" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock x:Name="DiscordCountText" Text="0 processes" Margin="0,4,0,0" FontSize="10" Foreground="#8792A8" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource ProcessCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Width="36" Height="36" CornerRadius="11" Background="#1DB954">
                                <Viewbox Width="21" Height="21">
                                    <Path Width="24" Height="24" Data="{StaticResource SpotifyIconGeometry}" Fill="#FFFFFF" Stretch="Uniform" />
                                </Viewbox>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Spotify" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock x:Name="SpotifyCountText" Text="0 processes" Margin="0,4,0,0" FontSize="10" Foreground="#8792A8" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Grid.Column="4" Style="{StaticResource ProcessCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Width="36" Height="36" CornerRadius="11" Background="#4285F4">
                                <Viewbox Width="21" Height="21">
                                    <Path Width="24" Height="24" Data="{StaticResource ChromeIconGeometry}" Fill="#FFFFFF" Stretch="Uniform" />
                                </Viewbox>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Chrome" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock x:Name="ChromeCountText" Text="0 processes" Margin="0,4,0,0" FontSize="10" Foreground="#8792A8" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <Border Height="112" Margin="0,18,0,0" Padding="18" CornerRadius="18"
                        Background="#131925" BorderBrush="#293142" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <CheckBox x:Name="AutoStartCheckBox" Content="Launch with Windows"
                                      Click="AutoStartCheckBox_Click" Style="{StaticResource ModernCheckBoxStyle}" />
                            <TextBlock Text="Starts quietly in the system tray." Margin="31,7,0,0"
                                       FontSize="10" Foreground="#7C879C" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="CheckForUpdatesButton" Width="142" Content="Check for updates"
                                    Click="CheckForUpdatesButton_Click" Style="{StaticResource ActionButtonStyle}" />
                            <Button Width="142" Margin="10,0,0,0" Content="Administrator Panel"
                                    Click="AdministratorPanelButton_Click" Style="{StaticResource ActionButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Margin="2,17,2,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="#58D695" VerticalAlignment="Center" />
                        <TextBlock Text="LOCAL PROCESSING" Margin="7,0,0,0"
                                   FontSize="9" FontWeight="Bold" Foreground="#768198" />
                    </StackPanel>
                    <TextBlock Text="VERSION 1.6.0" HorizontalAlignment="Right"
                               FontSize="9" FontWeight="SemiBold" Foreground="#626D82" />
                </Grid>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
